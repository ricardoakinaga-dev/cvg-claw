{
  "name": "cvg-claw",
  "version": "1.0.0",
  "description": "cvg-claw: governed autonomous agent runtime for hospital operations",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run --no-file-parallelism --maxWorkers=2",
    "test:coverage": "vitest run --coverage --no-file-parallelism --maxWorkers=2",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:postgres": "vitest run --testTimeout=60000 --no-file-parallelism packages/persistence/src/__tests__/postgres-migration-smoke.test.ts packages/persistence/src/__tests__/orchestrator-postgres.test.ts packages/persistence/src/__tests__/tenant-isolation.test.ts packages/persistence/src/__tests__/platform-postgres-smoke.test.ts packages/persistence/src/__tests__/platform-approval-postgres.test.ts packages/persistence/src/__tests__/audit-evidence-checkpoint-postgres.test.ts packages/persistence/src/__tests__/session-version-pinning-postgres.test.ts packages/persistence/src/__tests__/outbox-durability.test.ts packages/persistence/src/__tests__/effect-journal-postgres.test.ts packages/persistence/src/__tests__/channel-effect-journal-postgres.test.ts apps/api/src/__tests__/postgres-persistence-mode.test.ts apps/api/src/__tests__/webhook-security.test.ts apps/api/src/__tests__/journeys-api-postgres.test.ts apps/worker/src/__tests__/postgres-outbox-bridge.integration.test.ts packages/chaos/src/__tests__/chaos-postgres.test.ts packages/persistence/src/__tests__/journeys-postgres.test.ts apps/worker/src/__tests__/continuous-worker-postgres.integration.test.ts apps/worker/src/__tests__/postgres-role-preflight.test.ts packages/persistence/src/__tests__/attendance-approval-postgres.test.ts packages/persistence/src/__tests__/journey-task-atomicity.test.ts packages/persistence/src/__tests__/runtime-approval-store-postgres.test.ts apps/worker/src/__tests__/kernel-composition-postgres.integration.test.ts apps/worker/src/__tests__/kernel-durable-orchestrator-postgres.test.ts packages/persistence/src/__tests__/goal-concurrency-postgres.test.ts packages/persistence/src/__tests__/retention-postgres.test.ts apps/api/src/__tests__/operator-replay-store.test.ts apps/api/src/__tests__/operator-replay-guard.test.ts apps/worker/src/__tests__/continuous-worker-entrypoint.integration.test.ts packages/persistence/src/__tests__/runtime-approval-store-branch-hardening.test.ts apps/worker/src/__tests__/kernel-composition-branch-hardening.test.ts",
    "postgres:baseline": "tsx scripts/baseline-postgres.ts",
    "readiness": "vitest run tests/construction-readiness.test.js",
    "build": "npm run typecheck && npm run build:web",
    "build:web": "vite --config vite.config.mts build apps/web",
    "dev:api": "tsx apps/api/src/main.ts",
    "dev:web": "vite --config vite.config.mts apps/web --host 0.0.0.0",
    "dev:worker": "tsx apps/worker/src/main.ts",
    "test:worker:startup": "node scripts/worker-startup-smoke.mjs && node scripts/worker-controlled-smoke.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "docs:check": "node scripts/docs-check.mjs",
    "audit:security": "npm audit --audit-level=high",
    "verify": "npm run format:check && npm run docs:check && npm run typecheck && npm run lint && npm run build && npm test && npm run test:coverage && npm run audit:security",
    "docs:audit": "npm test",
    "test:evals": "vitest run packages/agent-evals --no-file-parallelism --maxWorkers=2",
    "evals:holdout:integrated": "tsx scripts/aud20-09-integrated-holdout.ts",
    "test:chaos": "vitest run packages/chaos --no-file-parallelism --maxWorkers=2",
    "test:aud20-19": "vitest run tests/aud20-19-qualification.test.js packages/chaos/src/__tests__ --no-file-parallelism --maxWorkers=2",
    "load:aud20-19:postgres": "tsx scripts/aud20-19-postgres-load.ts",
    "qualify:aud20-19": "node scripts/aud20-19-qualify.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "licenses:check": "node scripts/check-licenses.mjs",
    "certify": "npm run certify:phase11",
    "certification:verify": "npm run certification:verify:phase11",
    "certify:phase10": "node scripts/phase10-certify.mjs",
    "certification:verify:phase10": "node scripts/phase10-verify.mjs",
    "certify:phase11": "node scripts/phase11-certify.mjs",
    "certification:verify:phase11": "node scripts/phase11-verify.mjs",
    "evidence:verify:phase11": "node scripts/phase11-verify.mjs --evidence-only",
    "promotion:check": "node scripts/promotion-check.mjs --requested PRODUCTION",
    "production:preflight": "node scripts/production-preflight.mjs",
    "certification:verify:historical": "node scripts/phase10-verify.mjs --historical --base certification/logs/historical/2026-09-11-phase10",
    "certification:self-test": "node scripts/phase10-verify.mjs --self-test && npx prettier --write certification/negative-validation.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tanstack/react-query": "^5.100.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.3",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsx": "^4.23.12",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.2.1",
    "jsdom": "^29.1.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.10",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
