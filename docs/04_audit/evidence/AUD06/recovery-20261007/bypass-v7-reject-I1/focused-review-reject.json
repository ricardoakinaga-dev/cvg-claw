  "findings": [
    {
      "id": "Q13-V7-F01",
      "priority": "P1",
      "dimension": "certification measurement",
      "source": "scripts/phase11-bypass-audit.mjs",
      "line": 135,
      "relatedLines": [
        120,
        122,
        132,
        137,
        200
      ],
      "title": "SQL masking removes executable host-language template expressions",
      "criterion": "The exact quota file/table SQL exception must not permit other effects in that file; host syntax/template expressions must remain inspected.",
      "observed": "Three valid TypeScript fixtures return exit0/PASS/findings[]: fetch inside SQL value interpolation, fetch inside SQL line-comment interpolation, sendMessage inside SQL block-comment interpolation. Actual expression ASTs have no parse errors.",
      "cases": [
        "sql-value-fetch-expression",
        "sql-comment-fetch-expression",
        "sql-blockcomment-send-expression"
      ],
      "rootCause": "visit(span.expression) is concatenated into SQL literal text, then passed through stripSqlComments/maskSqlValues. SQL quotation/comments erase real executable expression code from the only normalized host source. Expressions remain executable before the SQL call irrespective of where their resulting text lies in SQL.",
      "boundedCorrection": "Inspect template span expression ASTs separately as executable host syntax; analyze SQL literal text separately with placeholders that cannot swallow or grant exemption to expression code. Keep existing exact quota exception.",
      "neededNegatives": [
        "fetch inside interpolated SQL single-quoted value",
        "fetch inside interpolated -- SQL comment",
        "sendMessage/axios/got/undici inside interpolated block comment",
        "Nested expressions inside nested templates and template-tag call arguments"
      ],
      "preservePositives": [
        "SQL literal values containing forbidden words remain inert",
        "Actual SQL comment prose remains ignored",
        "Pure safe interpolation and quota UPSERT stay accepted"
      ]
    },
    {
      "id": "Q13-V7-F02",
      "priority": "P1",
      "dimension": "certification measurement",
      "source": "scripts/phase11-bypass-audit.mjs",
      "line": 107,
      "relatedLines": [
        64,
        94,
        120,
        122
      ],
      "title": "Unconditional backslash escape handling masks a following domain statement",
      "criterion": "Mixed SQL statements may not inherit quota exception; literal-value masking must not discard subsequent writes.",
      "observed": "SQL-standard-backslash-value fixture, valid host parse, returns exit0/PASS/findings[]. Decoded SQL is INSERT INTO api_rate_limit_buckets VALUES ('literal\\'); DELETE FROM billing_items WHERE id=$1 . The literal is an ordinary SQL string, without E prefix.",
      "semanticLimit": "No SQL/DB executed. Under standard-conforming SQL string semantics the backslash is ordinary data and the next quote closes the value; the subsequent DELETE is a separate domain statement. The scanner incorrectly assumes backslash escapes a quote for every SQL string. Unspecified escape-mode uncertainty cannot justify a quota exemption.",
      "cases": [
        "SQL-standard-backslash-value"
      ],
      "rootCause": "Both SQL-comment stripping and value masking skip the character after every backslash while quoted, conflating ordinary strings with escape strings; masking stays active over the rest of the SQL.",
      "boundedCorrection": "Distinguish ordinary SQL string quoting from explicit escape-string syntax; retain following statements, or fail closed on unresolved lexical mode. Do not make a general quota-path exception.",
      "neededNegatives": [
        "Ordinary SQL backslash immediately before closing value quote followed by domain DELETE/UPDATE/INSERT",
        "Same source with a mixed quota/domain CTE or multiple statement sequence"
      ],
      "preservePositives": [
        "Ordinary quoted values with doubled apostrophes",
        "Actual E-prefixed escaped strings containing harmless SQL words",
        "Existing privilege read-only SQL and quota metadata values"
      ]
    }
  ],
