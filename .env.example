NODE_ENV=development
API_PERSISTENCE_MODE=memory
# Use postgres for a shared quota across API replicas; requires migration 0030.
API_RATE_LIMIT_STORE=memory
DATABASE_URL=postgres://user:password@localhost:5432/cvg_claw
DATABASE_MIGRATION_URL=postgres://migration_user:password@localhost:5432/cvg_claw
CVG_PRODUCTION_PREFLIGHT_ATTESTATION_FILE=
CVG_PRODUCTION_PREFLIGHT_ATTESTATION_SHA256=
INBOUND_TENANT_ID=tenant_00000000-0000-4000-8000-000000000001
INBOUND_AGENT_ID=agent_00000000-0000-4000-8000-000000000001
WEBHOOK_SIGNING_SECRET=replace_me_webhook_secret
API_ALLOWED_ORIGINS=https://console.example.test
API_REQUIRE_HTTPS=false
API_TRUSTED_PROXY_ADDRESSES=
API_TRUSTED_PROXY_HOPS=0
POSTGRES_AUTO_MIGRATE=false
POSTGRES_SCHEMA=
POSTGRES_RLS_ENFORCEMENT=false
OUTBOX_DURABLE_INBOUND=false
CVG_WORKER_QUEUE_ADAPTER=
CVG_WORKER_RUNTIME=kernel
CVG_WORKER_CONTROLLED_MODE=false
CVG_WORKER_TENANT_ID=tenant_00000000-0000-4000-8000-000000000001
CVG_WORKER_AGENT_ID=agent_00000000-0000-4000-8000-000000000001
CVG_WORKER_ID=worker-controlled-local
CVG_WORKER_MAX_EVENTS=10
CVG_DURABLE_KERNEL_ORCHESTRATOR=false
CVG_POLICY_MODE=deny_by_default
CVG_RISK_POLICY=required
CVG_APPROVAL_STORE=postgres
CVG_EFFECT_JOURNAL=postgres
CVG_MIGRATIONS_APPLIED_AT_LEAST=0
CVG_EXTERNAL_PROVIDER_APPROVED=false
CVG_EXTERNAL_CHANNEL_APPROVED=false
CVG_EXTERNAL_IDENTITY_APPROVED=false
CVG_EXTERNAL_RAG_APPROVED=false
CVG_RPO_RTO_MEASURED=false
CVG_SUPERVISED_PILOT_COMPLETE=false
CVG_ROLLBACK_VERIFIED=false
CVG_HUMAN_SIGNOFF=false
CVG_ALLOW_REAL_EFFECTS=false
CVG_REAL_EFFECTS=false
OPENAI_API_KEY=replace_me
ENABLE_REAL_CHANNELS=false
ENABLE_REAL_RAG=false
ENABLE_REAL_PAYMENTS=false
ENABLE_REAL_MEDICAL_RECORDS=false
